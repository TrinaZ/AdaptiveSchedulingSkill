{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "title": "DiagnosisReport",
 "type": "object",
 "required": [
  "type",
  "change_type",
  "adequate",
  "headroom"
 ],
 "properties": {
  "type": {
   "const": "DiagnosisReport"
  },
  "change_type": {
   "enum": [
    "distributional",
    "structural",
    "semantic"
   ]
  },
  "adequate": {
   "type": "boolean"
  },
  "headroom": {
   "type": "number"
  },
  "best_library": {
   "type": "string"
  },
  "best_literature": {
   "type": "string"
  },
  "diagnostics": {
   "type": "string"
  },
  "search_traffic": {
   "type": "object",
   "required": [
    "scene",
    "seed",
    "n"
   ],
   "properties": {
    "scene": {
     "type": "string"
    },
    "seed": {
     "type": "integer"
    },
    "n": {
     "type": "integer",
     "minimum": 1
    }
   }
  }
 }
}